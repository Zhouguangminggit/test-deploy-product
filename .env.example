# ============================== Django 基础 ==============================
DEBUG=False
SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
# 多个域名以英文逗号分隔。本文件仅供开发参考：生产环境部署时由 CI 通过
# APP_HOST Secret 注入真实域名/IP，镜像内固化值不会命中浏览器访问的 Host。
ALLOWED_HOSTS=localhost,127.0.0.1,1.92.92.195

# ============================== 时区与语言 ==============================
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# ============================== 站点信息 ==============================
SITE_NAME=Django Scaffold
SITE_DESCRIPTION=团队产品基座脚手架
# 前后台共用 logo（相对 static/ 的资源路径、站点根路径或完整 URL）；留空显示文字徽标
SITE_LOGO=

# ============================== 后台 UI 主题 ==============================
# Django 后台管理界面主题：可选 unfold（默认，现代化 Tailwind 风格）/ simpleui。
# 切换后基于本脚手架开发的业务系统后台即采用对应 UI；完整全局配置见 utils/admin_theme.py。
ADMIN_UI=unfold

# ============================== 数据库 ==============================
# 开发环境默认使用 SQLite，可不设置 DATABASE_URL。
# 生产环境使用第三方 MySQL（如阿里云 RDS）：
# 既可直接设置 DATABASE_URL，也可分别设置下方 MYSQL_* 变量。
# DATABASE_URL=mysql://app:password@rm-xxxx.mysql.rds.aliyuncs.com:3306/django_scaffold
MYSQL_DATABASE=django_scaffold
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ============================== Celery / Redis ==============================
# 异步任务 broker（开发默认指向团队共享开发 Redis，约定用 db1；本地调试也可 docker 起一个）：
#   redis://:密码@共享实例地址:6379/1
# 生产部署在服务器 deploy/.env.runtime 配置 Redis 内网地址：redis://:密码@实例地址:6379/0
REDIS_URL=redis://localhost:6379/1
# Celery worker 并发数（毕设级场景 2-4 即可）
CELERY_CONCURRENCY=2

# ============================== 日志（Loguru）==============================
# 日志级别：DEBUG / INFO / WARNING / ERROR（开发建议 DEBUG，生产建议 INFO）
LOG_LEVEL=INFO
# 文件日志目录；留空表示仅输出到控制台（容器环境推荐留空，由日志采集系统收集 stderr）
# 需要落盘时设置目录并确保已挂载卷，例如：LOG_DIR=logs
LOG_DIR=

# ============================== seedkit 数据初始化 ==============================
# Pixabay API 密钥（免费注册获取：https://pixabay.com/api/docs/）
# seedkit 初始化业务数据（make seed-data / 中台触发 seedkit_run）时抓取场景图片；
# 留空则跳过图片下载，仅填充结构化数据。线上由 CI / 中台统一注入。
PIXABAY_API_KEY=
# 统一业务数据配置文件（相对项目根目录）
SEEDKIT_CONFIG=seeds/seed_data.yml
# Pixabay 检索结果与图片的本地缓存目录（相对项目根目录）
SEEDKIT_CACHE_DIR=media/seed_cache

# ============================== 部署相关 ==============================
# 镜像构建时复制本文件作为默认值。生产 Django 配置写在服务器 deploy/.env.runtime。
# CI 生成 deploy/.env，保存镜像、端口和固定的 APP_COMPOSE_PROJECT。手动编排也使用该文件。
# 本机 make docker-up 从项目根目录的 .env 读取宿主机端口。
APP_PORT=8004
# Gunicorn 工作进程数（生产建议：CPU 核数 * 2 + 1）
GUNICORN_WORKERS=3
# 使用 RDS 等外部数据库时可跳过启动时的数据库等待（1=跳过，加速启动）
SKIP_DB_WAIT=1

# 产品授权：公钥为 JSON 对象，值为 PEM 字符串（换行写为 \n）
LICENSE_ENABLED=False
LICENSE_PRODUCT_ID=
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEYS={}
# 仅体验服务器环境变量使用，不应写入交付包
LICENSE_BYPASS=False
