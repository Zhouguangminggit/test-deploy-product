# ============================== Django 基础 ==============================
DEBUG=True
SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
# 多个域名以英文逗号分隔
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================== 时区与语言 ==============================
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# ============================== 站点信息 ==============================
SITE_NAME=Django Scaffold
SITE_DESCRIPTION=团队产品基座脚手架

# ============================== 数据库 ==============================
# 开发环境默认使用 SQLite，可不设置 DATABASE_URL。
# 生产环境使用 MySQL：既可直接设置 DATABASE_URL，也可分别设置下方 MYSQL_* 变量。
# DATABASE_URL=mysql://app:password@db:3306/django_scaffold
MYSQL_DATABASE=django_scaffold
MYSQL_USER=app
MYSQL_PASSWORD=please-change-me
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=please-change-me-root

# ============================== 日志（Loguru）==============================
# 日志级别：DEBUG / INFO / WARNING / ERROR（开发建议 DEBUG，生产建议 INFO）
LOG_LEVEL=DEBUG
# 文件日志目录；留空表示仅输出到控制台（容器环境推荐留空，由日志采集系统收集 stderr）
# 需要落盘时设置目录并确保已挂载卷，例如：LOG_DIR=logs
LOG_DIR=

# ============================== 部署相关 ==============================
# Gunicorn 工作进程数（生产建议：CPU 核数 * 2 + 1）
GUNICORN_WORKERS=3
# 是否启用 HTTPS 相关安全头（生产设置为 True）
SECURE_SSL_REDIRECT=False
