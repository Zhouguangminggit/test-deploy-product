{
  "name": "django-scaffold-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "django-scaffold 前端样式构建链（Tailwind CSS）",
  "scripts": {
    "build": "mkdir -p static/css/dist && tailwindcss -i static/css/base.css -o static/css/dist/base.css --minify",
    "dev": "mkdir -p static/css/dist && tailwindcss -i static/css/base.css -o static/css/dist/base.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=16.18"
  }
}
