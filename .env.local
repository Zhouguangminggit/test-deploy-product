# ============================== 本地开发环境 ==============================

# ============================== Django 基础 ==============================
DEBUG=False
SECRET_KEY=django-insecure-dev-only-key-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================== 时区与语言 ==============================
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# ============================== 站点信息 ==============================
SITE_NAME=Django Scaffold
SITE_DESCRIPTION=基于 Django 的工程化产品基座框架
SITE_LOGO=

# ============================== 后台 UI 主题 ==============================
ADMIN_UI=unfold

# ============================== Celery / Redis ==============================
REDIS_URL=redis://localhost:6379/1
CELERY_CONCURRENCY=2

# ============================== 日志（Loguru）==============================
LOG_LEVEL=INFO
LOG_DIR=

# ============================== seedkit 数据初始化 ==============================
PIXABAY_API_KEY=
SEEDKIT_CONFIG=seeds/seed_data.yml
SEEDKIT_CACHE_DIR=media/seed_cache



# 产品授权：公钥为 JSON 对象，值为 PEM 字符串（换行写为 \n）
LICENSE_ENABLED=True
LICENSE_PRODUCT_ID=190087168
LICENSE_SERVER_URL=https://license.szgy.site/
LICENSE_PUBLIC_KEYS='{"license-v1":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA1ketVT/H/x7UtgC57LCnnHiP1I2h6qKK/sscwNnsb7k=\n-----END PUBLIC KEY-----\n"}'
# 仅体验服务器环境变量使用，不应写入交付包
LICENSE_BYPASS=False